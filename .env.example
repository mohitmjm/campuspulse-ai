# Local demo uses SQLite. For production, run `npm run use:postgres` and set a Postgres URL (e.g. Neon free tier).
DATABASE_URL="file:./dev.db"

# Campaign day 1 (YYYY-MM-DD). Real-mode analytics count campaign days from this date.
CAMPAIGN_START_DATE="2026-11-02"

# Protects the dashboard's real-data view (aggregates only, never PII). Leave empty to disable the real view publicly.
ADMIN_KEY=""

# OPTIONAL. If set, the Copilot can add an LLM-written narrative on top of the deterministic rules engine.
# The product is fully functional without it. Never commit a real key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
