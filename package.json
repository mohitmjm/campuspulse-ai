{
  "name": "campuspulse-ai",
  "version": "1.0.0",
  "private": true,
  "description": "CampusPulse AI — the student growth & referral engine for the 'Build Your First AI Project in 60 Minutes' workshop campaign (simulation).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx scripts/seed-demo.ts",
    "setup": "prisma generate && prisma db push && tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docs:slides": "node scripts/build-slides.mjs",
    "use:postgres": "node scripts/use-postgres.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.21.1",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.453.0",
    "next": "14.2.15",
    "next-themes": "0.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.48.1",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "pptxgenjs": "3.12.0",
    "prisma": "5.21.1",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
